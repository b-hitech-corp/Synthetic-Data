{
  "schema": {
    "schema_version": "1.0",
    "topic_version": "v1",
    "topic_template": "minelogx/{topic_version}/{tenant_id}/{site_id}/{message_type}/{asset_type}/{asset_id}",
    "metadata_authority": "topic",
    "engine_hours_decimals": 2,
    "fuel_mode": "cumulative_total_litres",
    "distance_mode": "cumulative_odometer_km"
  },
  "generation": {
    "seed": 42,
    "cadence_seconds": 5,
    "duration_seconds": 60,
    "anomaly_rate": 0.05,
    "burst": {
      "enabled": false,
      "events_per_second": 250,
      "duration_seconds": 10
    }
  },
  "connectivity": {
    "mqtt_qos": 1,
    "buffer_enabled": true,
    "buffer_path": "buffer/events.sqlite3",
    "max_buffer_events": 100000,
    "retry_max_attempts": 5,
    "retry_backoff_seconds": [1, 2, 4, 8, 16],
    "replay_rate_per_second": 100
  },
  "tenants": [
    {
      "tenant_id": "acme-mining",
      "sites": [
        {
          "site_id": "site-01",
          "assets": [
            {
              "asset_id": "TRUCK-014",
              "asset_type": "haul_truck",
              "domain": "fleet"
            },
            {
              "asset_id": "CRUSHER-01",
              "asset_type": "fixed_crusher",
              "domain": "equipment_health"
            },
            {
              "asset_id": "AQ-001",
              "asset_type": "sensor_station",
              "domain": "environmental"
            }
          ]
        }
      ]
    }
  ]
}
