            {"asset_id_pattern": "ACME-S01-CRUSHER-{index:03d}", "count": 25, "asset_type": "fixed_crusher", "domain": "equipment_health"},
            {"asset_id_pattern": "ACME-S01-AQ-{index:03d}", "count": 25, "asset_type": "sensor_station", "domain": "environmental"}
          ]
        },
        {
          "site_id": "site-02",
          "assets": [
            {"asset_id_pattern": "ACME-S02-TRUCK-{index:03d}", "count": 100, "asset_type": "haul_truck", "domain": "fleet"},
            {"asset_id_pattern": "ACME-S02-CRUSHER-{index:03d}", "count": 25, "asset_type": "fixed_crusher", "domain": "equipment_health"},
            {"asset_id_pattern": "ACME-S02-AQ-{index:03d}", "count": 25, "asset_type": "sensor_station", "domain": "environmental"}
          ]
        }
      ]
    },
    {
      "tenant_id": "beta-minerals",
      "sites": [
        {
          "site_id": "north-site",
          "assets": [
            {"asset_id_pattern": "BETA-NORTH-TRUCK-{index:03d}", "count": 100, "asset_type": "haul_truck", "domain": "fleet"},
            {"asset_id_pattern": "BETA-NORTH-CRUSHER-{index:03d}", "count": 50, "asset_type": "fixed_crusher", "domain": "equipment_health"},
            {"asset_id_pattern": "BETA-NORTH-AQ-{index:03d}", "count": 50, "asset_type": "sensor_station", "domain": "environmental"}
          ]
